    "demo:data": "node tools/make-demo.mjs",
    "serve": "node tools/serve.mjs"
  },
  "keywords": ["bioinformatics", "workspace", "project-management", "dashboard", "provenance"],
  "files": ["tools", "templates", "schema", "prompts", "examples", "taxonomy.json", "README.md", "LICENSE"]
